{block content}
<article class="card">
    {if $project['image'] ?? null}
        <div class="project-hero">
            <img src="/images/{$project['image']}" alt="{$project['title'][locale()]}">
        </div>
    {/if}

    <div class="card-body">
        {if $project['featured']}<span class="badge">{t('projects.featured')}</span>{/if}
        <h1>{$project['title'][locale()]}</h1>

        <div class="project-sidebar">
            {if $project['client'] ?? null}
                <div class="sidebar-item">
                    <strong>{t('projects.client')}</strong>
                    <span>{$project['client']}</span>
                </div>
            {/if}
            <div class="sidebar-item">
                <strong>{t('projects.year')}</strong>
                <span>{$project['year']}</span>
            </div>
            <div class="sidebar-item">
                <strong>{t('projects.category')}</strong>
                <span>{$project['category']}</span>
            </div>
            {if $project['services'] ?? null}
                <div class="sidebar-item">
                    <strong>{t('projects.services')}</strong>
                    <span>{implode(', ', $project['services'])}</span>
                </div>
            {/if}
        </div>

        <p class="project-description">{$project['description'][locale()]}</p>

        {if $project['details'][locale()] ?? null}
            <p class="project-details">{$project['details'][locale()]}</p>
        {/if}

        {if $project['link'] !== '#'}
            <p><a href="{$project['link']}" target="_blank" class="btn">{t('projects.view')} &rarr;</a></p>
        {/if}

        <p class="back-link"><a href="{url(path: '/')}">&larr; {t('nav.home')}</a></p>
    </div>
</article>
{/block}
